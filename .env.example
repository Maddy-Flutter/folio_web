# ==============================================================================
# Follio Environment Configuration & Build Flags
# ==============================================================================
# Pass these variables via --dart-define or --dart-define-from-file=.env

# ------------------------------------------------------------------------------
# 1. Flavor Configuration
# ------------------------------------------------------------------------------
# Choose either 'user' (public site) or 'admin' (admin console)
FLAVOR=user

# ------------------------------------------------------------------------------
# 2. EmailJS Credentials (Used by Public Contact Form)
# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID=service_portfolio
EMAILJS_TEMPLATE_ID=template_contact_notice
EMAILJS_PUBLIC_KEY=user_yourEmailJsPublicKey
EMAILJS_AUTOREPLY_TEMPLATE_ID=template_auto_reply

# ------------------------------------------------------------------------------
# 3. Admin Authentication (Hashed Credentials)
# ------------------------------------------------------------------------------
# SHA-256 hash of expected username ("Madhavan")
ADMIN_USERNAME_HASH=642ed0bca90e038e74de2e45265ead2b5b700642e8a7e9ea02755792c88d73ee
# SHA-256 hash of expected password ("220701")
ADMIN_PASSWORD_HASH=38d5b2f7cb22e50d72ae183641e1e16bfd666f15f9c5dbfc9d600658ad1110fd

# ------------------------------------------------------------------------------
# 4. Cloud Firestore Configuration
# ------------------------------------------------------------------------------
# Optional: Provide your GCP / Firebase Project ID for remote sync.
# If omitted or offline, the app defaults gracefully to in-memory/local stores.
FIRESTORE_PROJECT_ID=your-firebase-project-id

# ==============================================================================
# Example Run Commands
# ==============================================================================
# Run Public Site:
# flutter run -d chrome -t lib/main_user.dart --dart-define=FLAVOR=user
#
# Run Admin Console:
# flutter run -d chrome -t lib/main_admin.dart \
#   --dart-define=FLAVOR=admin \
#   --dart-define=ADMIN_USERNAME_HASH=642ed0bca90e038e74de2e45265ead2b5b700642e8a7e9ea02755792c88d73ee \
#   --dart-define=ADMIN_PASSWORD_HASH=38d5b2f7cb22e50d72ae183641e1e16bfd666f15f9c5dbfc9d600658ad1110fd
