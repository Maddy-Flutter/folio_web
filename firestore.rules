rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the request is from an authenticated admin.
    // In production with Firebase Auth, this verifies the admin custom claim:
    // request.auth != null && request.auth.token.admin == true;
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // -------------------------------------------------------------------------
    // 1. Messages Collection (Contact Form Inquiries)
    // -------------------------------------------------------------------------
    // Public users can ONLY create messages with validated fields.
    // Only verified admins can read, update (mark as read), or delete messages.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'receivedAt', 'isRead'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.isRead == false;
      
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Analytics Collection (Visitor Metrics)
    // -------------------------------------------------------------------------
    // Public users can increment the total visitor counter document.
    // Only verified admins can read the aggregate summary.
    match /analytics/visitors {
      allow read: if isAdmin();
      // Allow atomic increment from public visitors
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisitors', 'updatedAt'])
                    && request.resource.data.totalVisitors == resource.data.totalVisitors + 1;
      allow create: if true;
    }

    match /analytics/summary {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. Profile Content Collection (Dynamic Portfolio Profile)
    // -------------------------------------------------------------------------
    // Anyone can read the published active profile document.
    // Only verified admins can publish updates.
    match /profile/active {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Version history of profile drafts is strictly admin-only.
    match /profile_versions/{versionId} {
      allow read, write: if isAdmin();
    }

    // Default deny for all other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
